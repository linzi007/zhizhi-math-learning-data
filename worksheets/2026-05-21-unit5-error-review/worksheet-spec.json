      "title": "四、应用题：第一步是不是最终答案？",
      "layout": "problem-grid-2",
      "items": [
        {
          "type": "word_problem",
          "prompt": "操场上踢足球的有17人，打篮球的有19人。踢足球的和打篮球的一共有多少人？",
          "answer_prompt": "答：一共有",
          "answer_suffix": "人",
          "work_lines": 2,
          "answer_detail": "`17 + 19 = 36`，答：一共有36人。"
        },
        {
          "type": "multi_step_word_problem",
          "prompt": "一瓶果汁连瓶重90克，喝了一半果汁后连瓶重54克。果汁原来重多少克？空瓶重多少克？",
          "answer_prompt": "答：果汁原来重",
          "answer_suffix": "克，空瓶重____克",
          "work_lines": 4,
          "review_status": "approved",
          "problem_structure": "先求喝掉的一半果汁，再翻倍求原来果汁重量，最后求空瓶重量。",
          "answer_detail": "`90 - 54 = 36`，36克是一半果汁；`36 + 36 = 72`，果汁原来重72克；`90 - 72 = 18`，空瓶重18克。"
        },
        {
          "type": "multi_step_word_problem",
          "prompt": "小明买一本故事书后还剩18元，如果买两本同样的故事书，还差12元。一本故事书多少元？",
          "answer_prompt": "答：一本故事书",
          "answer_suffix": "元",
          "work_lines": 4,
          "review_status": "approved",
          "problem_structure": "两种买法相差一本书，同时剩18元和差12元合起来就是一本书的价格。",
          "answer_detail": "买一本剩18元，买两本差12元；多买一本需要 `18 + 12 = 30` 元，所以一本故事书30元。"
        }
      ]
    }
